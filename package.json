{
  "name": "tabox",
  "version": "4.1.3",
  "description": "Tabox - Save and share your tabs!",
  "main": "index.js",
  "scripts": {
    "test": "jest --transformIgnorePatterns \"node_modules/(?!@toolz/allow-react)/\" --env=jsdom --coverage",
    "test:coverage:all": "jest --config jest.coverage-all.config.js --runInBand",
    "dev": "INLINE_RUNTIME_CHUNK=false NODE_ENV=development webpack --mode development --config webpack.js --watch",
    "build": "INLINE_RUNTIME_CHUNK=false NODE_ENV=production webpack --mode production --config webpack.js",
    "build:debug": "INLINE_RUNTIME_CHUNK=false NODE_ENV=production webpack --mode production --config webpack.js --env sourcemap=true",
    "build:release": "INLINE_RUNTIME_CHUNK=false NODE_ENV=production webpack --mode production --config webpack.js --env sourcemap=false --env drop_console=true",
    "build:analyze": "INLINE_RUNTIME_CHUNK=false NODE_ENV=production webpack --mode production --config webpack.js --profile --json > stats.json",
    "prod": "INLINE_RUNTIME_CHUNK=false NODE_ENV=production webpack --mode production --config webpack.js",
    "lint": "eslint './**/*.js'",
    "clean": "rm -rf build .cache",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "crxbox:sync": "npm pack ../crxbox --pack-destination ./vendor && yarn install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gilgold/tabox.git"
  },
  "keywords": [
    "tabox",
    "tab",
    "groups"
  ],
  "author": "Gil Goldstein",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gilgold/tabox/issues"
  },
  "homepage": "https://tabox.co",
  "jest": {
    "transform": {
      ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "chrome/sync-transport.js",
      "chrome/sync-merge.js",
      "chrome/sync-apply.js",
      "chrome/sync-session-state.js",
      "app/utils/migrationSupport40.js"
    ],
    "coverageThreshold": {
      "./chrome/sync-transport.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./chrome/sync-merge.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./chrome/sync-apply.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./chrome/sync-session-state.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./app/utils/migrationSupport40.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results/jest",
          "outputName": "report.xml"
        }
      ]
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "jsx",
      "ts",
      "tsx",
      "node"
    ],
    "setupFiles": [
      "jest-webextension-mock",
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/zz_repro"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "javascript-time-ago": "^2.5.11",
    "jotai": "^2.15.1",
    "react": "^19.0.0",
    "react-countdown-circle-timer": "^3.2.1",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-select": "^5.10.2",
    "react-time-ago": "^7.3.3",
    "react-tiny-popover": "^8.1.6",
    "react-tooltip": "^5.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^13.0.0",
    "crxbox": "^1.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-jest": "^28.10.0",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-transform-stub": "^2.0.0",
    "jest-webextension-mock": "^3.9.0",
    "style-loader": "^4.0.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-extension-manifest-plugin": "^0.8.0"
  },
  "packageManager": "yarn@4.12.0"
}
