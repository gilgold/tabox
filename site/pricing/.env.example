# Paddle configuration for the Tabox pricing page build (site/pricing/build-pricing.mjs).
# Copy to .env and fill in real values. NEVER commit real values or the server API key.

# Which Paddle account/environment to build against. Required. No default — the build
# fails loudly if this is unset or not one of: production | sandbox.
PADDLE_ENV=production

# Public CLIENT-SIDE token (safe to expose in the page). Prefixed live_ for production,
# test_ for sandbox. Create it in Paddle: Developer Tools > Authentication > Client-side tokens
# (or via the paddle-live MCP: client.clientTokens.create). This is NOT the server API key.
PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxx

# Canonical site origin for the checkout success redirect (successUrl = ${SITE_URL}/welcome).
# Optional — defaults to https://www.tabox.co. Must be an https origin with no path.
# Important on Wix: do NOT rely on window.location.origin, because an "Embed HTML" block
# runs in a sandbox iframe whose origin is not tabox.co.
SITE_URL=https://www.tabox.co

# The server-side API key is intentionally absent here — it must never appear in the
# pricing page or any client build. It is not used by this build at all.
